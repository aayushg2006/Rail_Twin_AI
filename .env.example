# RAIL-TWIN configuration. Copy to `.env` and edit; every value has a safe default.

# ---- Frontend (Vite) ----
# WebSocket URL the browser uses to reach the backend twin.
# Defaults to ws://<host>:8000/ws when unset, so this is optional for local dev.
VITE_BACKEND_WS_URL=ws://localhost:8000/ws
# Configurable raster source for the interactive MapLibre view. The local demo
# uses standard OSM tiles with visible attribution and no prefetching.
VITE_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png


# ================================ Backend =====================================
# All backend settings use the RAILTWIN_ prefix.

# Determinism: the same seed reproduces the same run exactly.
RAILTWIN_SEED=42

# Clock. DEMO pins the simulation to the busiest window the timetable covers
# (14:10 IST on the reference day); LIVE runs on the real wall clock.
RAILTWIN_CLOCK_MODE=LIVE

# Optional persistence. Omit both to run fully in memory - the twin degrades
# gracefully and the demo never depends on them.
RAILTWIN_DATABASE_URL=postgresql://rail:rail@localhost:5432/railtwin
RAILTWIN_REDIS_URL=redis://localhost:6379/0

# CORS (comma-separated); * is fine for a local demo.
RAILTWIN_CORS_ORIGINS=*


# ---------------------------- RailRadar live data -----------------------------
# RailRadar (https://railradar.in/docs) supplies running status for PASSENGER
# services. It is NOT a position stream: each call returns a delay in minutes
# and the last reported halt, which the twin assimilates as an observation and
# interpolates between. Goods movements have no public feed anywhere and remain
# synthetic - the console labels them as such.
#
# Mode:
#   off     never touches the network. Entry lateness is drawn from a
#           distribution instead. This is the default.
#   replay  serves data/railradar-replay.json through the identical ingestion
#           path. Use this for demos: no key, no quota, no network dependency.
#   live    calls the API. Requires a key and spends the monthly budget.
RAILTWIN_RAILRADAR_MODE=replay

# Get a key from the RailRadar developer console. Required only for live mode.
# Never commit a real key - keep it in .env, which is gitignored.
RAILTWIN_RAILRADAR_API_KEY=

# The free tier allows 1,000 requests per MONTH (~33/day). The client keeps a
# counter in Redis and refuses to call once the allowance is spent, so an
# overnight run cannot silently exhaust your quota.
RAILTWIN_RAILRADAR_MONTHLY_BUDGET=1000

# How the budget is spent. With 6 trains polled every 20 minutes a continuous
# run costs ~432 calls/day, so raise the interval or shrink the watchlist if you
# intend to leave it running. The watchlist is always the services closest to
# their booked time at Vasai Road.
RAILTWIN_RAILRADAR_CACHE_TTL_SECONDS=900
RAILTWIN_RAILRADAR_TIMEOUT_SECONDS=8

# Endpoint and station. BSR is Vasai Road.
RAILTWIN_RAILRADAR_BASE_URL=https://api.railradar.in
RAILTWIN_RAILRADAR_STATION=BSR
RAILTWIN_RAILRADAR_REPLAY_FILE=data/railradar-replay.json

# Poll cadence. The station board is one call returning every train due at BSR,
# so it is the primary feed; per-train detail is only fetched for services
# actually inside the modelled section (platform + speedToNextStationKmph).
#   60 s board + 300 s detail is roughly 70-130 calls an hour, so the 1,000 a
#   month allowance is about 8-14 hours of live running. Budget accordingly.
RAILTWIN_RAILRADAR_BOARD_SECONDS=60
RAILTWIN_RAILRADAR_DETAIL_SECONDS=300
# Calls held back so a demo is never left without data. Below the reserve the
# board drops to 300 s and detail stops; below a fifth of it the twin falls back
# to replay automatically rather than going blind.
RAILTWIN_RAILRADAR_RESERVE=150

# Store every observation, so the delay model can later be retrained on real
# lateness rather than on simulated variance.
RAILTWIN_RAILRADAR_COLLECT=true


# --------------------------- Optimisation objective ---------------------------
# J = W_conflict * residual_conflicts + W_passenger * passenger_minutes
#   + W_freight * freight_tonne_minutes + W_hold * hold_sec
#   + W_route * route_changes - W_throughput * cleared
# Passenger-minutes is the primary term: it is what a section controller is
# really trading. See backend/app/optimize/objective.py.
# RAILTWIN_W_PASSENGER=1.0
# RAILTWIN_W_FREIGHT=0.009
# RAILTWIN_W_CONFLICT=1.0
# RAILTWIN_W_HOLD=0.02
# RAILTWIN_W_ROUTE=25
# RAILTWIN_W_THROUGHPUT=40

# ---- ML ----
# Below this confidence a prediction is reported as LOW_CONFIDENCE and the
# deterministic projection stays authoritative.
# RAILTWIN_ML_CONFIDENCE_FLOOR=0.35

# ---- Release benchmark ----
# HMAC key used to sign benchmark-latest.json. A result remains NOT VALIDATED
# when this is blank, even if every numerical target passes.
RAILTWIN_BENCHMARK_SIGNING_KEY=
RAILTWIN_BENCHMARK_REPORT_PATH=data/benchmark-latest.json
